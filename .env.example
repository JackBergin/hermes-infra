# Compose configuration ONLY. This file does not contain Hermes credentials.
# The stable tag is for first-time setup. Pin to a resolved @sha256 digest for production.
HERMES_IMAGE=nousresearch/hermes-agent:stable
# Keep the bind mount local to this repository unless intentionally relocating it.
HERMES_STATE_DIR=./state
# Official published image normally runs Hermes as UID/GID 10000.
HERMES_UID=10000
HERMES_GID=10000
